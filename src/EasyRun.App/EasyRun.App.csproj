<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EasyRun.App</RootNamespace>
    <AssemblyName>EasyRun</AssemblyName>
    <AssemblyTitle>EasyRun</AssemblyTitle>
    <Description>Create and manage Run-box aliases and elevated shortcuts.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(AppIcon)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyRun.Core\EasyRun.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EasyRun.Tests" />
  </ItemGroup>
</Project>
